{
    "http": {
        "host": "0.0.0.0",
        "port": 3000,
        "cors": {
            "enabled": false,
            "origin": "*",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS"
            ],
            "headers": [
                "Content-Type"
            ]
        }
    },
    "websocket": {
        "path": "/ws",
        "heartbeatIntervalMs": 15000,
        "handshakeTimeoutMs": 5000,
        "maxIncomingPayloadBytes": 65536,
        "maxBufferedBytes": 10485760,
        "shutdownGraceMs": 2000,
        "compression": true,
        "compressionThresholdBytes": 1024
    }
}
